# SERV Triage Agent — copy to .env and fill in (never commit .env)
# Get a key at https://console.openserv.ai (free account; credits are prepaid).
# Without SERV_API_KEY the app runs in MOCK mode (deterministic stub, no cost).

SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
SERV_REASONING_EFFORT=low
SERV_BASE_URL=https://inference-api.openserv.ai
PORT=8000
